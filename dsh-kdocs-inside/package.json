{
  "name": "dsh-kdocs-inside",
  "version": "0.2.6",
  "description": "金山文档 (KDocs) for DeepSeek Harness — browse, preview and quote documents from the right sidebar, with four read-only Agent tools backed by the official kdocs-cli",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "default": "./src/index.js"
    },
    "./service": {
      "default": "./src/service.js"
    },
    "./types": {
      "default": "./src/types.js"
    },
    "./errors": {
      "default": "./src/errors.js"
    },
    "./typert": {
      "default": "./typert.host.js"
    },
    "./remote-client": {
      "default": "./typert.remote-client.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json",
    "./resource": {
      "default": "./src/resource.js"
    },
    "./tools": {
      "default": "./src/tools.js"
    }
  },
  "files": [
    "src",
    "client.js",
    "typert.host.js",
    "typert.remote-client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "zod": "^4.6.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-gateway": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-typert-registry": "^0.1.5-rc.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:live": "KDOCS_LIVE=require node --test test/m2-gate.test.js test/tools.test.js test/resource.test.js test/remote-contract.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vansonffff/dsh-kdocs.git",
    "directory": "dsh-kdocs-inside"
  },
  "homepage": "https://github.com/vansonffff/dsh-kdocs#readme",
  "license": "MIT",
  "private": false
}
