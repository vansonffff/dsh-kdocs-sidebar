{
  "name": "kdocs-settings",
  "version": "0.2.0",
  "description": "金山文档 (kdocs) status panel for DeepSeek Harness — shows whether kdocs-cli is installed and signed in, and nothing else",
  "type": "module",
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vansonffff/dsh-kdocs-sidebar.git",
    "directory": "kdocs-settings"
  },
  "homepage": "https://github.com/vansonffff/dsh-kdocs-sidebar#readme",
  "bugs": {
    "url": "https://github.com/vansonffff/dsh-kdocs-sidebar/issues"
  },
  "license": "MIT"
}
